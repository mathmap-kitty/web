        {
          "id": "A",
          "text": "[[(2,-3)]]"
        },
        {
          "id": "B",
          "text": "[[(3,2)]]"
        },
        {
          "id": "C",
          "text": "[[(2,3)]]"
        },
        {
          "id": "D",
          "text": "[[(-3,2)]]"
        }
      ],
      "answerSpec": {
        "kind": "singleChoice",
        "correctOptionIds": [
          "B"
        ]
      },
      "explanation": "一般式 [[ax+by+c=0]] 的法向量可取 [[(a,b)]]，方向向量可取 [[(b,-a)]]。因此本題可取 [[(-3,-2)]] 或其倍數，選項中的 [[(3,2)]] 與它方向相反但平行，仍是方向向量。",
      "distractorMap": {
        "A": "linecir.REPRESENTATION.001",
        "C": "linecir.REPRESENTATION.001",
        "D": "linecir.REPRESENTATION.001"
      },
      "source": {
